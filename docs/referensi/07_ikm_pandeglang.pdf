<div class="unis_support_chat" id="unisSupportChat"
	data-logged-in="0"
	data-login-url="https://ejournal.unis.ac.id/index.php/jutis/login"
	data-send-url="https://ejournal.unis.ac.id/index.php/jutis/support/send">
	<button type="button" class="unis_support_fab" id="unisSupportFab" aria-expanded="false" aria-controls="unisSupportPanel" aria-label="Bantuan sistem">
		<svg class="unis_support_fab_icon" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H13l-3.2 3.2c-.7.7-1.8.2-1.8-.7V16H6.5A2.5 2.5 0 0 1 4 13.5v-7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
			<path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
		</svg>
	</button>

	<div class="unis_support_panel" id="unisSupportPanel" hidden>
		<div class="unis_support_panel_head">
			<div>
				<p class="unis_support_panel_eyebrow">Bantuan Sistem</p>
				<h2 class="unis_support_panel_title">Chat Support</h2>
			</div>
			<button type="button" class="unis_support_close" id="unisSupportClose" aria-label="Tutup">×</button>
		</div>
		<p class="unis_support_panel_lead">Laporkan masalah teknis portal ejournal. Pesan dikirim ke tim support.</p>
		<form class="unis_support_form" id="unisSupportForm" novalidate>
			<input type="hidden" name="csrfToken" value="37d7b35b8c1d8e777847ed5f5c89c253" />
			<label class="unis_support_field">
				<span>Nama</span>
				<input type="text" name="name" id="unisSupportName" required maxlength="120"
					value=""
					>
			</label>
			<label class="unis_support_field">
				<span>Email</span>
				<input type="email" name="email" id="unisSupportEmail" required maxlength="180"
					value=""
					>
			</label>
			<label class="unis_support_field">
				<span>Masalah</span>
				<textarea name="message" id="unisSupportMessage" rows="4" required maxlength="4000" placeholder="Jelaskan kendala yang Anda alami..."></textarea>
			</label>
			<p class="unis_support_status" id="unisSupportStatus" role="status" aria-live="polite" hidden></p>
			<button type="submit" class="unis_support_submit" id="unisSupportSubmit">Kirim Pesan</button>
		</form>
	</div>
</div>

<script>
(function () {
	var root = document.getElementById('unisSupportChat');
	if (!root) return;
	var fab = document.getElementById('unisSupportFab');
	var panel = document.getElementById('unisSupportPanel');
	var closeBtn = document.getElementById('unisSupportClose');
	var form = document.getElementById('unisSupportForm');
	var statusEl = document.getElementById('unisSupportStatus');
	var submitBtn = document.getElementById('unisSupportSubmit');
	var loggedIn = root.getAttribute('data-logged-in') === '1';
	var loginUrl = root.getAttribute('data-login-url');
	var sendUrl = root.getAttribute('data-send-url');

	function setStatus(text, isError) {
		if (!statusEl) return;
		statusEl.hidden = !text;
		statusEl.textContent = text || '';
		statusEl.classList.toggle('is-error', !!isError);
		statusEl.classList.toggle('is-ok', !!text && !isError);
	}

	function openPanel() {
		if (!loggedIn) {
			var next = encodeURIComponent(window.location.href);
			window.location.href = loginUrl + (loginUrl.indexOf('?') >= 0 ? '&' : '?') + 'source=' + next;
			return;
		}
		panel.hidden = false;
		fab.setAttribute('aria-expanded', 'true');
		root.classList.add('is-open');
		var msg = document.getElementById('unisSupportMessage');
		if (msg) setTimeout(function () { msg.focus(); }, 50);
	}

	function closePanel() {
		panel.hidden = true;
		fab.setAttribute('aria-expanded', 'false');
		root.classList.remove('is-open');
		setStatus('', false);
	}

	fab.addEventListener('click', function () {
		if (root.classList.contains('is-open')) closePanel();
		else openPanel();
	});
	if (closeBtn) closeBtn.addEventListener('click', closePanel);

	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape' && root.classList.contains('is-open')) closePanel();
	});

	if (form) {
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			if (!loggedIn) {
				openPanel();
				return;
			}
			setStatus('', false);
			submitBtn.disabled = true;
			submitBtn.textContent = 'Mengirim...';

			var data = new FormData(form);
			data.append('pageUrl', window.location.href);
			fetch(sendUrl, {
				method: 'POST',
				body: data,
				credentials: 'same-origin',
				headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
			}).then(function (res) {
				return res.json().then(function (json) {
					return { ok: res.ok, status: res.status, json: json || {} };
				}).catch(function () {
					return { ok: false, status: res.status, json: { error: 'Respons tidak valid.' } };
				});
			}).then(function (result) {
				if (result.json && result.json.loginRequired) {
					openPanel();
					return;
				}
				if (result.ok && result.json.ok) {
					setStatus(result.json.message || 'Pesan terkirim.', false);
					form.querySelector('[name="message"]').value = '';
				} else {
					setStatus((result.json && result.json.error) || 'Gagal mengirim pesan.', true);
				}
			}).catch(function () {
				setStatus('Koneksi gagal. Coba lagi.', true);
			}).finally(function () {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Kirim Pesan';
			});
		});
	}
})();
</script>

