			.is_site_unis .unis_header_actions.is-open {
				display: flex !important;
			}
			.is_site_unis .unis_header_user,
			.is_site_unis .unis_nav_user,
			.is_site_unis .unis_nav_user.pkp_nav_list,
			.is_site_unis .unis_nav_user > li,
			.is_site_unis .unis_nav_user > li > ul,
			.is_site_unis .unis_nav_user ul {
				display: flex !important;
				flex-direction: column !important;
				align-items: stretch !important;
				width: 100% !important;
				gap: 8px !important;
			}
			.is_site_unis .unis_header_search,
			.is_site_unis .unis_nav_user a {
				width: 100% !important;
				justify-content: center !important;
				box-sizing: border-box !important;
				border-radius: 999px !important;
				padding: 12px 14px !important;
			}
		}

		@media (max-width: 640px) {
			.is_site_unis .pkp_structure_head {
				padding: 12px 12px 8px !important;
			}
			.is_site_unis .unis_header_title { font-size: 17px !important; }
		}

		/* Keep footer at viewport bottom on short pages */
		.is_site_unis .pkp_structure_page {
			min-height: 100vh !important;
			display: flex !important;
			flex-direction: column !important;
		}
		.is_site_unis .pkp_structure_content {
			flex: 1 0 auto !important;
		}
		.is_site_unis .pkp_structure_footer_wrapper {
			margin-top: auto !important;
		}

		/* Halaman situs selain homepage — layout normal terpusat */
		.is_site_unis:not(.is_site_home) .pkp_structure_content {
			width: 100% !important;
			max-width: 100% !important;
			padding-top: 0 !important;
		}
		.is_site_unis:not(.is_site_home) .pkp_structure_main {
			width: 100% !important;
			max-width: 800px !important;
			margin: 0 auto !important;
			float: none !important;
			padding: 32px 24px 48px !important;
		}
		.is_site_unis:not(.is_site_home) .pkp_structure_main:before,
		.is_site_unis:not(.is_site_home) .pkp_structure_main:after {
			display: none !important;
			content: none !important;
		}
		.is_site_unis:not(.is_site_home) .pkp_structure_sidebar {
			display: none !important;
		}

		/* ===== Footer ===== */
		.unis_footer.pkp_structure_footer_wrapper {
			background: #0f172a !important;
			color: #cbd5e1 !important;
			margin-top: 0 !important;
			width: 100% !important;
			max-width: 100% !important;
		}
		.unis_footer .pkp_structure_footer {
			max-width: 1200px !important;
			margin: 0 auto !important;
			padding: 40px 24px 24px !important;
			text-align: left !important;
		}
		.unis_footer .unis_footer_main {
			display: grid !important;
			grid-template-columns: 1fr !important;
			gap: 32px !important;
			padding-bottom: 28px !important;
			border-bottom: 1px solid rgba(255,255,255,0.1) !important;
		}
		.unis_footer .unis_footer_brand {
			display: flex !important;
			align-items: flex-start !important;
			gap: 16px !important;
		}
		.unis_footer .unis_footer_logo {
			flex-shrink: 0 !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			width: 64px !important;
			height: 64px !important;
			background: #fff !important;
			border-radius: 10px !important;
			padding: 6px !important;
			text-decoration: none !important;
		}
		.unis_footer .unis_footer_logo img {
			max-width: 100% !important;
			max-height: 100% !important;
			object-fit: contain !important;
			display: block !important;
		}
		.unis_footer .unis_footer_brand_text h3 {
			margin: 0 0 8px !important;
			font-size: 16px !important;
			font-weight: 700 !important;
			color: #fff !important;
			line-height: 1.35 !important;
		}
		.unis_footer .unis_footer_brand_text p {
			margin: 0 !important;
			font-size: 13px !important;
			line-height: 1.6 !important;
			color: #94a3b8 !important;
			max-width: 360px !important;
		}
		.unis_footer .unis_footer_columns {
			display: grid !important;
			grid-template-columns: repeat(2, 1fr) !important;
			gap: 24px !important;
		}
		.unis_footer .unis_footer_col h4 {
			margin: 0 0 12px !important;
			font-size: 12px !important;
			font-weight: 700 !important;
			text-transform: uppercase !important;
			letter-spacing: 0.06em !important;
			color: #e2e8f0 !important;
		}
		.unis_footer .unis_footer_col ul {
			list-style: none !important;
			margin: 0 !important;
			padding: 0 !important;
		}
		.unis_footer .unis_footer_col li + li {
			margin-top: 8px !important;
		}
		.unis_footer .unis_footer_col a {
			color: #94a3b8 !important;
			text-decoration: none !important;
			font-size: 13px !important;
			transition: color 0.15s !important;
		}
		.unis_footer .unis_footer_col a:hover {
			color: #fff !important;
		}
		.unis_footer .pkp_footer_content {
			padding: 20px 0 !important;
			border-top: none !important;
			color: #94a3b8 !important;
			font-size: 13px !important;
		}
		.unis_footer .unis_footer_bottom {
			display: flex !important;
			align-items: center !important;
			justify-content: space-between !important;
			gap: 16px !important;
			padding-top: 20px !important;
			flex-wrap: wrap !important;
		}
		.unis_footer .unis_footer_copy {
			margin: 0 !important;
			font-size: 12px !important;
			color: #64748b !important;
			line-height: 1.5 !important;
		}
		.unis_footer .unis_footer_ojs {
			display: block !important;
			opacity: 0.6 !important;
			transition: opacity 0.15s !important;
			float: none !important;
			margin: 0 !important;
		}
		.unis_footer .unis_footer_ojs:hover { opacity: 1 !important; }
		.unis_footer .unis_footer_ojs img {
			display: block !important;
			height: 32px !important;
			width: auto !important;
		}
		.unis_footer .pkp_brand_footer {
			display: none !important;
		}
		@media (min-width: 768px) {
			.unis_footer .unis_footer_main {
				grid-template-columns: 1.4fr 1fr !important;
				align-items: start !important;
			}
		}

		/* Ejournal UNIS — kategori di pinggir, katalog di tengah */
		.is_site_home .pkp_structure_content {
			background: #f1f5f9 !important;
			width: 100% !important;
			max-width: 100% !important;
			padding: 0 !important;
			margin: 0 !important;
		}
		.is_site_home .pkp_structure_main {
			width: 100% !important;
			max-width: 100% !important;
			margin: 0 !important;
			float: none !important;
			padding: 0 !important;
			position: relative !important;
		}
		.is_site_home .pkp_structure_main:before,
		.is_site_home .pkp_structure_main:after {
			display: none !important;
			content: none !important;
		}
		.is_site_home .pkp_structure_sidebar {
			display: none !important;
		}
		.is_site_home .page_index_site,
		.is_site_home .journals_library {
			max-width: 100% !important;
			margin: 0 !important;
			padding: 0 !important;
			overflow-x: hidden !important;
		}
		body.is_site_home,
		body.is_site_unis {
			overflow-x: hidden !important;
		}

		/* ===== Landing hero + center carousel (ref) ===== */

		.is_site_home .unis_landing_hero,
		.page_index_site .unis_landing_hero {
			position: relative !important;
			overflow: hidden !important;
			display: flex !important;
			flex-direction: column !important;
			align-items: center !important;
			gap: 28px !important;
			padding: 40px 0 48px !important;
			color: #0f172a !important;
			background: #eef1f6 !important;
			touch-action: pan-y !important;
		}
		.is_site_home .unis_landing_hero_intro,
		.page_index_site .unis_landing_hero_intro {
			width: 100% !important;
			max-width: 720px !important;
			margin: 0 auto !important;
			padding: 0 24px !important;
			text-align: center !important;
			z-index: 2 !important;
		}
		.is_site_home .unis_landing_brand,
		.page_index_site .unis_landing_brand {
			margin: 0 0 8px !important;
			font-family: "Fraunces", Georgia, serif !important;
			font-size: clamp(26px, 3.6vw, 40px) !important;
			font-weight: 700 !important;
			line-height: 1.15 !important;
			letter-spacing: -0.025em !important;
			color: #0b1f3a !important;
			text-wrap: balance !important;
		}
		.is_site_home .unis_landing_title,
		.page_index_site .unis_landing_title {
			margin: 0 0 10px !important;
			font-family: "Outfit", sans-serif !important;
			font-size: clamp(15px, 1.6vw, 18px) !important;
			font-weight: 600 !important;
			color: #0f766e !important;
			line-height: 1.4 !important;
		}
		.is_site_home .unis_landing_lead,
		.page_index_site .unis_landing_lead {
			margin: 0 auto 20px !important;
			max-width: 520px !important;
			font-family: "Outfit", sans-serif !important;
			font-size: 15px !important;
			line-height: 1.65 !important;
			color: #64748b !important;
		}
		.is_site_home .unis_landing_cta,
		.page_index_site .unis_landing_cta {
			display: flex !important;
			flex-wrap: wrap !important;
			justify-content: center !important;
			gap: 10px !important;
		}
		.is_site_home .unis_landing_btn,
		.page_index_site .unis_landing_btn {
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
			padding: 12px 20px !important;
			border-radius: 999px !important;
			font-family: "Outfit", sans-serif !important;
			font-size: 14px !important;
			font-weight: 600 !important;
			text-decoration: none !important;
			transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease !important;
		}
		.is_site_home .unis_landing_btn:hover,
		.page_index_site .unis_landing_btn:hover {
			transform: translateY(-2px) !important;
		}
		.is_site_home .unis_landing_btn_primary,
		.page_index_site .unis_landing_btn_primary {
			background: linear-gradient(135deg, #34d399 0%, #10b981 100%) !important;
			color: #052e16 !important;
			box-shadow: 0 8px 22px rgba(16,185,129,0.25) !important;
		}
		.is_site_home .unis_landing_btn_ghost,
		.page_index_site .unis_landing_btn_ghost {
			background: #fff !important;
			color: #0b1f3a !important;
			border: 1px solid #cbd5e1 !important;
		}

		/* Center-mode carousel — overlapping coverflow like ref */
		.is_site_home .unis_coverflow,
		.page_index_site .unis_coverflow {
			position: relative !important;
			width: 100% !important;
			max-width: 1180px !important;
			margin: 0 auto !important;
			height: clamp(320px, 34vw, 400px) !important;
			min-height: 300px !important;
			outline: none !important;
			cursor: grab !important;
			user-select: none !important;
			padding: 12px 0 28px !important;
			box-sizing: content-box !important;
		}
		.is_site_home .unis_coverflow.is-dragging,
		.page_index_site .unis_coverflow.is-dragging {
			cursor: grabbing !important;
		}
		.is_site_home .unis_coverflow_stage,
		.page_index_site .unis_coverflow_stage {
			position: absolute !important;
			inset: 12px 0 28px !important;
			overflow: visible !important;
		}
		.is_site_home .unis_cover_card,
		.page_index_site .unis_cover_card {
			--card-w: min(700px, 58vw);
			position: absolute !important;
			left: 50% !important;
			top: 50% !important;
			width: var(--card-w) !important;
			height: min(100%, 380px) !important;
			margin: 0 !important;
			border: 0 !important;
			border-radius: 28px !important;
			overflow: hidden !important;
			display: grid !important;
			grid-template-columns: 1.05fr 0.95fr !important;
			background: #0b1f3a !important;
			box-shadow: 0 12px 30px rgba(15, 23, 42, 0.14) !important;
			transform: translate3d(-50%, -50%, 0) scale(0.78) !important;
			opacity: 0 !important;
			visibility: hidden !important;
			pointer-events: none !important;
			transition: transform .45s cubic-bezier(.25,.8,.25,1), opacity .35s ease, box-shadow .35s ease !important;
			z-index: 1 !important;
			cursor: pointer !important;
			backface-visibility: hidden !important;
			-webkit-backface-visibility: hidden !important;
			will-change: transform, opacity !important;
		}
		.is_site_home .unis_cover_card::after,
		.page_index_site .unis_cover_card::after {
			content: "" !important;
			position: absolute !important;
			inset: 0 !important;
			z-index: 4 !important;
			background: rgba(15, 23, 42, 0.38) !important;
			pointer-events: none !important;
			opacity: 1 !important;
			transition: opacity .3s ease !important;
		}
		.is_site_home .unis_cover_card_media,
		.page_index_site .unis_cover_card_media {
			position: relative !important;
			min-height: 100% !important;
			order: 2 !important;
			background:
				radial-gradient(ellipse 70% 55% at 60% 40%, rgba(45,212,191,0.25), transparent 60%),
				linear-gradient(145deg, #e2e8f0 0%, #f8fafc 100%) !important;
			background-size: cover !important;
			background-position: center !important;
		}
		.is_site_home .unis_cover_card_media::before,
		.page_index_site .unis_cover_card_media::before {
			content: "" !important;
			position: absolute !important;
			inset: 0 auto 0 0 !important;
			width: 28% !important;
			z-index: 1 !important;
			background: linear-gradient(90deg, #0b1f3a 0%, rgba(11,31,58,0) 100%) !important;
			pointer-events: none !important;
		}
		.is_site_home .unis_cover_card.has-cover .unis_cover_card_media,
		.page_index_site .unis_cover_card.has-cover .unis_cover_card_media {
			background-image: var(--cover) !important;
			background-size: cover !important;
			background-position: center !important;
		}
		.is_site_home .unis_cover_card--ft .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(56,189,248,0.35), transparent 60%), linear-gradient(145deg, #0c4a6e 0%, #e0f2fe 100%) !important; }
		.is_site_home .unis_cover_card--fkip .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(52,211,153,0.32), transparent 60%), linear-gradient(145deg, #064e3b 0%, #d1fae5 100%) !important; }
		.is_site_home .unis_cover_card--feb .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(251,191,36,0.28), transparent 60%), linear-gradient(145deg, #78350f 0%, #fef3c7 100%) !important; }
		.is_site_home .unis_cover_card--fisip .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(125,211,252,0.3), transparent 60%), linear-gradient(145deg, #1e3a8a 0%, #dbeafe 100%) !important; }
		.is_site_home .unis_cover_card--fh .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(252,165,165,0.28), transparent 60%), linear-gradient(145deg, #7f1d1d 0%, #fee2e2 100%) !important; }
		.is_site_home .unis_cover_card--lppm .unis_cover_card_media,
		.is_site_home .unis_cover_card--other .unis_cover_card_media { background-image: radial-gradient(ellipse 60% 50% at 60% 40%, rgba(45,212,191,0.32), transparent 60%), linear-gradient(145deg, #115e59 0%, #ccfbf1 100%) !important; }
		.is_site_home .unis_cover_card.has-cover .unis_cover_card_media,
		.page_index_site .unis_cover_card.has-cover .unis_cover_card_media {
			background-image: var(--cover) !important;
		}
		.is_site_home .unis_cover_card_body,
		.page_index_site .unis_cover_card_body {
			position: relative !important;
			z-index: 2 !important;
			order: 1 !important;
			padding: clamp(22px, 2.6vw, 36px) clamp(20px, 2.4vw, 34px) !important;
			display: flex !important;
			flex-direction: column !important;
			justify-content: center !important;
			align-items: flex-start !important;
			gap: 8px !important;
			background: linear-gradient(135deg, #0b1f3a 0%, #152a4a 55%, #123445 100%) !important;
		}
		.is_site_home .unis_cover_card_kicker,
		.page_index_site .unis_cover_card_kicker {
			margin: 0 !important;
			font-family: "Outfit", sans-serif !important;
			font-size: 12px !important;
			font-weight: 600 !important;
			letter-spacing: 0.12em !important;
			text-transform: uppercase !important;
			color: #6ee7b7 !important;
		}
		.is_site_home .unis_cover_card_title,
		.page_index_site .unis_cover_card_title {
			margin: 0 !important;
			font-family: "Outfit", sans-serif !important;
			font-size: clamp(17px, 1.85vw, 26px) !important;
			font-weight: 800 !important;
			line-height: 1.18 !important;
			letter-spacing: -0.02em !important;
			text-transform: uppercase !important;
			color: #fff !important;
			display: -webkit-box !important;
			-webkit-line-clamp: 3 !important;
			-webkit-box-orient: vertical !important;
			overflow: hidden !important;
		}
		.is_site_home .unis_cover_card_cat,
		.page_index_site .unis_cover_card_cat {
			margin: 2px 0 6px !important;
			font-family: "Outfit", sans-serif !important;
			font-size: 14px !important;
			line-height: 1.45 !important;
			color: rgba(226,232,240,0.88) !important;
		}
		.is_site_home .unis_cover_card_btn,
		.page_index_site .unis_cover_card_btn {
			margin-top: 10px !important;
			display: inline-flex !important;
			align-items: center !important;
			gap: 6px !important;
			padding: 12px 20px !important;
			border-radius: 999px !important;
			background: #fff !important;
			color: #0b1f3a !important;
			font-family: "Outfit", sans-serif !important;
			font-size: 13px !important;
			font-weight: 700 !important;
			text-decoration: none !important;
			box-shadow: 0 6px 16px rgba(0,0,0,0.15) !important;
			transition: transform .2s ease, background .2s ease !important;
			position: relative !important;
			z-index: 5 !important;
		}
		.is_site_home .unis_cover_card_btn:hover,
		.page_index_site .unis_cover_card_btn:hover {
			background: #ecfdf5 !important;
			transform: translateY(-1px) !important;
		}

		/* Active = large center; sides tucked behind (overlap) */
		.is_site_home .unis_cover_card.is-active,
		.page_index_site .unis_cover_card.is-active {
			transform: translate3d(-50%, -50%, 0) scale(1) !important;
			opacity: 1 !important;
			visibility: visible !important;
			pointer-events: auto !important;
			z-index: 6 !important;
			box-shadow: 0 28px 60px rgba(15, 23, 42, 0.28) !important;
		}
		.is_site_home .unis_cover_card.is-active::after,
		.page_index_site .unis_cover_card.is-active::after {
			opacity: 0 !important;
		}
		.is_site_home .unis_cover_card.is-prev,
		.page_index_site .unis_cover_card.is-prev {
			transform: translate3d(calc(-50% - 48%), -50%, 0) scale(0.86) !important;
			opacity: 1 !important;
			visibility: visible !important;
			pointer-events: auto !important;
			z-index: 3 !important;
		}
		.is_site_home .unis_cover_card.is-next,
		.page_index_site .unis_cover_card.is-next {
			transform: translate3d(calc(-50% + 48%), -50%, 0) scale(0.86) !important;
			opacity: 1 !important;
			visibility: visible !important;
			pointer-events: auto !important;
			z-index: 3 !important;
		}
		/* Only 3 cards visible: hide far sides */
		.is_site_home .unis_cover_card.is-prev2,
		.is_site_home .unis_cover_card.is-next2,
		.page_index_site .unis_cover_card.is-prev2,
		.page_index_site .unis_cover_card.is-next2 {
			transform: translate3d(-50%, -50%, 0) scale(0.7) !important;
			opacity: 0 !important;
			visibility: hidden !important;
			pointer-events: none !important;
			z-index: 1 !important;
		}

		/* Dots sit on bottom of active card */
		.is_site_home .unis_hero_slide_nav,
		.page_index_site .unis_hero_slide_nav {
			position: absolute !important;
			left: 50% !important;
			bottom: 42px !important;
			transform: translateX(-50%) !important;
			z-index: 8 !important;
			display: flex !important;
			align-items: center !important;
			gap: 8px !important;
			padding: 0 !important;
			background: transparent !important;
			pointer-events: auto !important;
		}
		.is_site_home .unis_hero_dot,
		.page_index_site .unis_hero_dot {
			width: 8px !important;
			height: 8px !important;
			min-width: 8px !important;
			padding: 0 !important;
			border: 0 !important;
			border-radius: 999px !important;
			background: rgba(255,255,255,0.45) !important;
			cursor: pointer !important;
			transition: background .25s ease, transform .25s ease !important;
			pointer-events: auto !important;
		}
		.is_site_home .unis_hero_dot.is-active,
		.page_index_site .unis_hero_dot.is-active {
			width: 8px !important;
			background: #3b82f6 !important;
			transform: scale(1.2) !important;
		}
		.is_site_home .unis_hero_arrow,
		.page_index_site .unis_hero_arrow {
			position: absolute !important;
			top: 50% !important;
			transform: translateY(-50%) !important;
			z-index: 9 !important;
			width: 46px !important;
			height: 46px !important;
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
			padding: 0 !important;
			border: 0 !important;
			border-radius: 999px !important;
			background: rgba(255,255,255,0.88) !important;
			color: #0b1f3a !important;
			cursor: pointer !important;
			box-shadow: 0 8px 22px rgba(15,23,42,0.14) !important;
			backdrop-filter: blur(8px) !important;
			transition: background .2s ease, transform .2s ease, box-shadow .2s ease !important;
			pointer-events: auto !important;
		}
		.is_site_home .unis_hero_arrow:hover,
