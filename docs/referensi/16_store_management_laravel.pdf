		<article class="obj_article_details">

		
	<h1 class="page_title">
		Rancang Bangun Website Store Management System Laravel dengan Metode Agile: Studi Kasus UMKM Toko Jali
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
					<h2 class="pkp_screen_reader">Penulis</h2>
