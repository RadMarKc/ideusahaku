		<article class="obj_article_details">

		
	<h1 class="page_title">
		Pengembangan Platform E-Commerce UMKM Berbasis Laravel dengan Blackbox Testing dan Metode Waterfall
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
