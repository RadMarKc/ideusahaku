		<article class="obj_article_details">

		
	<h1 class="page_title">
		Pengembangan Website UMKM Desa Teniga dengan Laravel dan Vue.js
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
					<h2 class="pkp_screen_reader">Penulis</h2>
					<ul class="authors">
											<li>
							<span class="name">
								Fazlul Rahman
